layout {

    focus-ring {
        active-color   "#adcbdd"
        inactive-color "#121415"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#adcbdd"
        inactive-color "#121415"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#adcbdd"
        inactive-color "#7795a5"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#adcbdd80"
    }
}

recent-windows {
    highlight {
        active-color "#adcbdd"
        urgent-color "#ffb4ab"
    }
}
